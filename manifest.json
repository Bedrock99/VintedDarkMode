{
  "manifest_version": 3,
  "name": "Vinted Dark Mode",
  "version": "1.0.0",
  "description": "Eleganter Dark Mode für Vinted mit integriertem Schalter im Header direkt vor der Hilfe. Spart Akku und schont die Augen. Inoffizielle Community-Erweiterung.",
  "author": "Vinted Community",
  "browser_specific_settings": {
    "gecko": {
      "id": "vinted-darkmode@addons.mozilla.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.vinted.de/*",
    "*://*.vinted.fr/*",
    "*://*.vinted.com/*",
    "*://*.vinted.co.uk/*",
    "*://*.vinted.it/*",
    "*://*.vinted.es/*",
    "*://*.vinted.pl/*",
    "*://*.vinted.nl/*",
    "*://*.vinted.be/*",
    "*://*.vinted.at/*",
    "*://*.vinted.cz/*",
    "*://*.vinted.lt/*",
    "*://*.vinted.pt/*",
    "*://*.vinted.se/*",
    "*://*.vinted.ro/*",
    "*://*.vinted.hu/*",
    "*://*.vinted.sk/*",
    "*://*.vinted.dk/*",
    "*://*.vinted.fi/*",
    "*://*.vinted.lu/*",
    "*://*.vinted.lv/*",
    "*://*.vinted.ee/*",
    "*://*.vinted.hr/*",
    "*://*.vinted.si/*",
    "*://*.vinted.gr/*",
    "*://*.vinted.bg/*",
    "*://*.vinted.ie/*",
    "*://*.vinted.ca/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Vinted Dark Mode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.vinted.de/*",
        "*://*.vinted.fr/*",
        "*://*.vinted.com/*",
        "*://*.vinted.co.uk/*",
        "*://*.vinted.it/*",
        "*://*.vinted.es/*",
        "*://*.vinted.pl/*",
        "*://*.vinted.nl/*",
        "*://*.vinted.be/*",
        "*://*.vinted.at/*",
        "*://*.vinted.cz/*",
        "*://*.vinted.lt/*",
        "*://*.vinted.pt/*",
        "*://*.vinted.se/*",
        "*://*.vinted.ro/*",
        "*://*.vinted.hu/*",
        "*://*.vinted.sk/*",
        "*://*.vinted.dk/*",
        "*://*.vinted.fi/*",
        "*://*.vinted.lu/*",
        "*://*.vinted.lv/*",
        "*://*.vinted.ee/*",
        "*://*.vinted.hr/*",
        "*://*.vinted.si/*",
        "*://*.vinted.gr/*",
        "*://*.vinted.bg/*",
        "*://*.vinted.ie/*",
        "*://*.vinted.ca/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
